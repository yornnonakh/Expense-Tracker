# Production template. Copy to .env (or set these as your host's environment
# variables) and replace every secret. Never commit the filled-in file.

NODE_ENV=production
PORT=8787

# GENERATE YOUR OWN. The two below are examples and must not be reused:
#   openssl rand -base64 48
#
# The server refuses to boot when NODE_ENV=production if these are left at the
# development defaults, are under 32 characters, or are equal to each other —
# an access secret that also validates refresh tokens turns a refresh token
# into a permanent access token.
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-openssl-rand-base64-48

ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# MUST point at a mounted persistent volume. A container filesystem is
# recreated on every deploy; a database inside the image takes every account
# with it. The Dockerfile defaults this to /data/expense-tracker.db.
DATABASE_PATH=/data/expense-tracker.db

# The iOS app is not a browser and sends no Origin header, so CORS is not what
# protects this API — authentication is. Narrow it anyway if a web client is
# ever added.
CORS_ORIGIN=*
