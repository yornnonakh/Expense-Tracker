# Copy to .env and change the secrets before running anywhere but localhost.
PORT=8787
NODE_ENV=development

# MUST be replaced in production. The server refuses to boot with these
# defaults when NODE_ENV=production.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

DATABASE_PATH=./data/expense-tracker.db
CORS_ORIGIN=*
